#shellcheck shell=bash
# Bash completion for whatlang. Installed by 'make install' to COMPDIR,
# or load by hand: source .bash_completion

_whatlang() {
  local -- cur=${COMP_WORDS[COMP_CWORD]} prev=${COMP_WORDS[COMP_CWORD-1]}
  local -- head='' tail
  local -a codes=()
  COMPREPLY=()

  case $prev in
    -L|--langs)
      # complete the item after the last comma
      tail=$cur
      if [[ $cur == *,* ]]; then
        head=${cur%,*},
        tail=${cur##*,}
      fi
      mapfile -t codes < <(whatlang -l 2>/dev/null)
      mapfile -t COMPREPLY < <(compgen -P "$head" -W "${codes[*]}" -- "$tail")
      compopt -o nospace 2>/dev/null ||:
      return 0
      ;;
  esac

  if [[ $cur == -* ]]; then
    mapfile -t COMPREPLY < <(compgen -W \
      '-c -L -l -V -h --confidence --langs --list --version --help' -- "$cur")
  fi
  # anything else falls through to default filename completion
  return 0
}

complete -o bashdefault -o default -F _whatlang whatlang
#fin
